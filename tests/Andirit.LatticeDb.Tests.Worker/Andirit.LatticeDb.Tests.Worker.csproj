<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Andirit.LatticeDb.Tests.Worker</AssemblyName>
    <RootNamespace>Andirit.LatticeDb.Tests.Worker</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The worker is a standalone console harness that exercises the PRODUCTION store only. It
    intentionally does not reference the test project: the test project references the worker so
    that 'dotnet test' on the test project builds and copies the worker assembly, which is what
    the multi-process cases (D-05, P-15) need. The reverse dependency would be a cycle.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Andirit.LatticeDb\Andirit.LatticeDb.csproj" />
    <ProjectReference Include="..\..\src\Andirit\Andirit.csproj" />
  </ItemGroup>

</Project>