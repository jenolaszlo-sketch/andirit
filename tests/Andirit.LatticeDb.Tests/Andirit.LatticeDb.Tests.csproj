<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Andirit.LatticeDb\Andirit.LatticeDb.csproj" />
    <ProjectReference Include="..\..\src\Andirit.Testing\Andirit.Testing.csproj" />
    <!--
      The multi-process cases (NativeDurabilityTests D-05 and NativePublicationCorrectnessTests
      P-15) launch the standalone worker as a separate OS process. This reference makes 'dotnet
      test' build and copy the worker assembly into this project's output, so the cases work when
      the test project is built on its own (for example by the per-project CI test steps), not only
      when the whole solution is built.
    -->
    <ProjectReference Include="..\Andirit.LatticeDb.Tests.Worker\Andirit.LatticeDb.Tests.Worker.csproj" />
  </ItemGroup>

</Project>
