<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Penghou.Andirit.Abstractions\Penghou.Andirit.Abstractions.csproj" />
    <ProjectReference Include="..\Penghou.Andirit\Penghou.Andirit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Penghou.Andirit.TreeSitter</PackageId>
    <Title>Penghou Andirit Tree-sitter Plugin</Title>
    <Authors>Penghou.Andirit contributors</Authors>
    <Description>Tree-sitter structural code extraction for Penghou.Andirit. Elixir, TypeScript, and JavaScript through pinned grammars; broader language coverage follows the same provider pattern.</Description>
    <PackageTags>tree-sitter;code-analysis;knowledge-graph;elixir;typescript;javascript;parsing</PackageTags>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/penghou-andirit</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jenolaszlo-sketch/penghou-andirit</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Pinned grammar natives ship inside this package per runtime identifier.
    They are also copied to the build output so tests and hosts resolve them
    without additional probing configuration. See native/grammar-pins.md for
    the rebuild procedure when a grammar pin changes.
  -->
  <!-- One explicit entry per runtime: new grammar pins extend this list. -->
  <ItemGroup>
    <Content Include="runtimes/win-x64/native/*" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/win-x64/native" />
    <Content Include="runtimes/linux-x64/native/*" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/linux-x64/native" />
    <Content Include="runtimes/osx-arm64/native/*" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/osx-arm64/native" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
