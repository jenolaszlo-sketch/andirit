<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Local feed first so the smoke test resolves the just-packed Hetu
    packages; nuget.org supplies third-party dependencies. CI points the
    local feed at the pack output via the SMOKE_FEED environment variable
    by rewriting this file, or by passing /p:RestoreSources.
  -->
  <packageSources>
    <clear />
    <add key="smoke-feed" value="%SMOKE_FEED%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
