<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- QUAL-04 reviewer harness built against the reserved test assembly name
         (established reviewer pattern); it never modifies real test projects. -->
    <AssemblyName>Andirit.CSharp.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..</RepoRoot>
    <NoWarn>$(NoWarn);CS8618;CS0618</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)/src/Andirit/Andirit.csproj" />
    <ProjectReference Include="$(RepoRoot)/src/Andirit.CSharp/Andirit.CSharp.csproj" />
    <ProjectReference Include="$(RepoRoot)/src/Andirit.LatticeDb/Andirit.LatticeDb.csproj" />
    <!-- Frozen R2 authority derivation (historical evidence, read-only). -->
    <Compile Include="$(RepoRoot)/docs/evidence/adr-ci1-01-ci1a-s2-1-raw/authority/CompilationProvenance.cs" Link="FrozenR2Authority.cs" />
  </ItemGroup>
</Project>