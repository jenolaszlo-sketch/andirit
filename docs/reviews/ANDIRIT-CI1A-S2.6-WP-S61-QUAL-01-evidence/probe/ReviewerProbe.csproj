<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Named to match InternalsVisibleTo("Andirit.LatticeDb.Tests") on the production
         assembly, so this reviewer-owned probe can reach the INTERNAL fault-injector
         constructor. This project lives OUTSIDE the repository and is NOT part of
         Andirit.slnx; it is a diagnostic instrument only. -->
    <AssemblyName>Andirit.LatticeDb.Tests</AssemblyName>
    <RootNamespace>Andirit.LatticeDb.Tests.ReviewerProbe</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\Andirit.LatticeDb\Andirit.LatticeDb.csproj" />
    <ProjectReference Include="$(RepoRoot)\src\Andirit\Andirit.csproj" />
  </ItemGroup>

</Project>
