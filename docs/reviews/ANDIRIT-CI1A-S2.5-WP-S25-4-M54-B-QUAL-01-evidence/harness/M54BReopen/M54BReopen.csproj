<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Distinct-process reopen leg. Built against the reserved reviewer assembly
         identity so the live authority boundary (Andirit.CSharp internals) can be
         reconstructed in the reopen process; it never modifies real test projects. -->
    <AssemblyName>Andirit.CSharp.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..</RepoRoot>
    <NoWarn>$(NoWarn);CS8618;CS0618</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)/src/Andirit/Andirit.csproj" />
    <ProjectReference Include="$(RepoRoot)/src/Andirit.CSharp/Andirit.CSharp.csproj" />
    <ProjectReference Include="$(RepoRoot)/src/Andirit.LatticeDb/Andirit.LatticeDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ReopenMain.cs" />
    <Compile Include="../SharedFixture.cs" />
    <Compile Include="../UniverseFactory.cs" />
  </ItemGroup>

</Project>