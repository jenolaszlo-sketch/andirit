<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone S2.0 semantic corpus oracle. This project deliberately references
    only Roslyn; it does not reference any Andirit production assembly, so it
    cannot call the production identity or occurrence code it is meant to test.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SemanticCorpusOracle</AssemblyName>
    <RootNamespace>SemanticCorpusOracle</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
