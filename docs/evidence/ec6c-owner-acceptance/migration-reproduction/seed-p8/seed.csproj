<Project Sdk="Microsoft.NET.Sdk">
  <!--
    EC6C-OWNER-01 FQ1-EV-1 reproduction tooling: authentic p8 seed harness.
    This harness MUST be built against a checkout of the pre-publication
    implementation (detached worktree at 8c1d5e3). Pass the checkout root as
    the HetuRoot MSBuild property and the workspace root as the program
    argument. Build outputs stay under this directory (bin/obj, gitignored).
    Exact commands: see ../README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Root of the Penghou.Hetu checkout to bind against; required for this harness. -->
    <HetuRoot Condition="'$(HetuRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..</HetuRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HetuRoot)\src\Penghou.Hetu.TreeSitter\Penghou.Hetu.TreeSitter.csproj" />
    <ProjectReference Include="$(HetuRoot)\src\Penghou.Hetu.LatticeDb\Penghou.Hetu.LatticeDb.csproj" />
  </ItemGroup>
</Project>
